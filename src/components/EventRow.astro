---
import Button from './Button.astro';
import VideoCard from './VideoCard.astro';
import { googleCalendarUrl, type EventItem } from '../lib/content';
interface Props { e: EventItem; showPast?: boolean }
const { e, showPast = false } = Astro.props;
const hasMedia = e.photos.length + e.videos.length + e.films.length > 0;
const bits: string[] = [];
const vids = e.films.length + e.videos.length;
if (e.photos.length) bits.push(`${e.photos.length} ${e.photos.length === 1 ? 'photo' : 'photos'}`);
if (vids) bits.push(`${vids} ${vids === 1 ? 'video' : 'videos'}`);
---
<div class="eventrow" id={e.anchor} data-region={e.region} data-free={e.free ? '1' : '0'} data-upcoming={showPast ? '0' : '1'}>
  <div class="eventrow__card">
    <article class="rs-event">
      <div class="rs-event__date"><span class="rs-event__day">{e.day}</span>{e.month}</div>
      <div>
        <div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:6px;flex-wrap:wrap">
          <h3 class="rs-event__title">{e.title}</h3>
          <span class={`rs-badge rs-badge--${e.badge.tone}`}>{e.badge.label}</span>
        </div>
        {e.support && <div style="font-size:var(--fs-body-sm);color:var(--text-body);margin-bottom:6px;max-width:52ch">{e.support}</div>}
        <div class="meta">{[e.venue, e.time].filter(Boolean).join(' · ')}</div>
        <div style="display:flex;gap:var(--sp-2);margin-top:var(--sp-3);flex-wrap:wrap">
          {e.tags.map((t) => <span class="rs-tag rs-tag--outline">{t}</span>)}
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:var(--sp-4)">
        {!showPast && e.price && <span style="font:var(--type-meta);color:var(--text-primary);white-space:nowrap">{e.price}</span>}
      </div>
    </article>
  </div>
  <div class="eventrow__actions">
    {showPast ? (
      <>
        <span class="finished">Finished</span>
        {hasMedia && <span class="mediacount">{bits.join(' · ')}</span>}
        {hasMedia && <Button variant="secondary" data-toggle={`media-${e.slug}`} aria-expanded="false" aria-controls={`media-${e.slug}`} data-open-label="Hide" data-closed-label="Photos & video">Photos &amp; video</Button>}
      </>
    ) : (
      <>
        {e.ticketUrl
          ? <Button href={e.ticketUrl} external>Book tickets</Button>
          : <Button variant="secondary" href={googleCalendarUrl(e)} external>Add to calendar</Button>}
        {e.details.length > 0 && <Button variant="ghost" data-toggle={`details-${e.slug}`} aria-expanded="false" aria-controls={`details-${e.slug}`} data-open-label="Less info" data-closed-label="More info">More info</Button>}
      </>
    )}
  </div>
  {!showPast && e.details.length > 0 && (
    <div class="eventrow__panel" id={`details-${e.slug}`} hidden>
      {e.details.map((d) => <p>{d}</p>)}
    </div>
  )}
  {showPast && hasMedia && (
    <div class="eventrow__panel eventrow__panel--media" id={`media-${e.slug}`} hidden>
      {(e.films.length + e.videos.length) > 0 && (
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px">
          {[...e.films, ...e.videos].map((v) => (
            <VideoCard title={v.title} artist={v.song} episode={v.episode} duration={v.duration} image={v.image} tone={v.tone} url={v.url} embed={v.embed} />
          ))}
        </div>
      )}
      {e.photos.length > 0 && (
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
          {e.photos.map((p) => (
            <a href={p.src} class="photo" data-lightbox data-alt={p.alt} data-caption={`${e.dow} ${Number(e.day)} ${e.month} · ${e.title}${p.credit ? ` · Photo: ${p.credit}` : ''}`}>
              <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      )}
    </div>
  )}
</div>
