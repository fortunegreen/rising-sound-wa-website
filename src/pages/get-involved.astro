---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TierCard from '../components/TierCard.astro';
import { getMembership } from '../lib/content';
import { pathways } from '../lib/copy';
const m = await getMembership();
---
<Base
  title="Get Involved | Musicians, Venues & Members | Rising Sound WA"
  description="Play a session, host a show or become a member. Members keep Rising Sound WA's free sessions free."
>
  <section style="background:#000;border-bottom:1px solid var(--line-hairline)">
    <div style="max-width:1360px;margin:0 auto;padding:clamp(48px,8vw,96px) 24px 72px">
      <span class="eyebrow" style="color:var(--rs-amber)">Get involved</span>
      <h1 style="margin:20px 0 0;max-width:20ch;font:var(--type-display);letter-spacing:var(--ls-display);text-transform:uppercase;color:var(--rs-bone-50)">Three ways in.</h1>
    </div>
  </section>

  <section style="background:var(--rs-ink-900)">
    <div style="max-width:1360px;margin:0 auto;padding:clamp(40px,7vw,72px) 24px">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:24px">
        {pathways.map((w) => (
          <div style="background:var(--surface-1);border:1px solid var(--line-hairline);padding:32px 28px 36px;display:flex;flex-direction:column;gap:16px;min-height:280px">
            <span class="eyebrow" style="color:var(--rs-amber)">{w.num}</span>
            <h2 style="margin:0;font:var(--type-h3);letter-spacing:var(--ls-heading);text-transform:uppercase;color:var(--rs-bone-50)">{w.title}</h2>
            <p style="margin:0;font-size:var(--fs-body-sm);line-height:var(--lh-body);color:var(--text-body);flex:1">{w.long}</p>
            <div><Button variant="secondary" href={w.href}>{w.cta}</Button></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="membership" style="background:#000;border-top:1px solid var(--line-hairline);scroll-margin-top:96px">
    <div class="wrap">
      <SectionHeading eyebrow="Membership" title="Keep the free shows free" />
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,400px));gap:24px;margin-top:48px;align-items:start">
        {m.tiers.map((t) => <TierCard tier={t} />)}
      </div>
      <p class="mono" style="margin:32px 0 0">{m.note}</p>
    </div>
  </section>
</Base>
