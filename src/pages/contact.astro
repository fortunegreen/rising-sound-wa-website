---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { getSettings } from '../lib/content';
import { enquiryOptions } from '../lib/copy';
const s = await getSettings();
---
<Base
  title="Contact Rising Sound WA"
  description="Email Rising Sound WA about performing, venues, membership or media. Find us at Saturday Sessions at Midland Records, Midland."
>
  <section style="background:#000;border-bottom:1px solid var(--line-hairline)">
    <div style="max-width:1360px;margin:0 auto;padding:clamp(48px,8vw,96px) 24px 72px">
      <span class="eyebrow" style="color:var(--rs-amber)">Contact</span>
      <h1 style="margin:20px 0 0;max-width:20ch;font:var(--type-display);letter-spacing:var(--ls-display);text-transform:uppercase;color:var(--rs-bone-50)">Say hello.</h1>
    </div>
  </section>

  <section style="background:var(--rs-ink-900)">
    <div style="max-width:1360px;margin:0 auto;padding:clamp(48px,8vw,96px) 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:clamp(48px,8vw,96px);align-items:start">
      <div style="display:flex;flex-direction:column;gap:40px">
        <div>
          <h2 class="eyebrow" style="margin:0 0 16px;color:var(--rs-amber)">Where we play</h2>
          <p style="margin:0;line-height:var(--lh-body);color:var(--text-primary)">{s.venueName}<br />{s.venueAddress}</p>
        </div>
        <div>
          <h2 class="eyebrow" style="margin:0 0 16px;color:var(--rs-amber)">Email</h2>
          <p style="margin:0;line-height:var(--lh-body);color:var(--text-primary)"><a href={`mailto:${s.email}`} style="color:inherit">{s.email}</a></p>
        </div>
      </div>

      <div style="background:var(--surface-1);border:1px solid var(--line-hairline);padding:clamp(24px,5vw,40px)">
        <h2 style="margin:0 0 32px;font:var(--type-h2);letter-spacing:var(--ls-heading);text-transform:uppercase;color:var(--rs-bone-50)">Send us a message</h2>
        <div id="contact-done" hidden>
          <p style="margin:0;font:var(--type-h3);color:var(--rs-bone-50)">Thanks — message sent.</p>
          <p style="margin:12px 0 0;font-size:var(--fs-body-sm);line-height:var(--lh-body);color:var(--text-body)">We read everything and will get back to you soon.</p>
        </div>
        <form id="contact-form" data-busy="Sending…" style="display:grid;gap:24px">
          <div class="rs-field"><label class="rs-label" for="c-name">Name</label><input class="rs-input" id="c-name" name="name" type="text" required placeholder="Your name" autocomplete="name" /></div>
          <div class="rs-field"><label class="rs-label" for="c-email">Email</label><input class="rs-input" id="c-email" name="email" type="email" required placeholder="you@email.com" autocomplete="email" /></div>
          <div class="rs-field">
            <label class="rs-label" for="c-enquiry">What's this about?</label>
            <select class="rs-input" id="c-enquiry" name="enquiry">
              {enquiryOptions.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
          <div class="rs-field"><label class="rs-label" for="c-message">Message</label><textarea class="rs-input" id="c-message" name="message" rows="5" required placeholder="Tell us what you're after" style="resize:vertical;min-height:140px"></textarea></div>
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div style="display:flex;justify-content:flex-end"><Button type="submit" size="lg">Send message</Button></div>
          <p class="form-error" role="alert" hidden></p>
        </form>
      </div>
    </div>
  </section>
</Base>
