# Online editing (Keystatic GitHub mode). Never commit the real .env.
# Keystatic writes these for you the first time you run `npm run dev:github` and create the GitHub App.
# Then add the same four values in Cloudflare (see ADMIN-SETUP.md).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
