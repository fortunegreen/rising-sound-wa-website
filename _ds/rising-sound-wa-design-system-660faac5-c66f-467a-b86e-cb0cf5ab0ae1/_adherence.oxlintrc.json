      {
        "selector": "JSXOpeningElement[name.name='VideoCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|voltage|amber|flare|ink)$/]",
        "message": "<VideoCard> tone must be one of 'teal' | 'voltage' | 'amber' | 'flare' | 'ink'."
