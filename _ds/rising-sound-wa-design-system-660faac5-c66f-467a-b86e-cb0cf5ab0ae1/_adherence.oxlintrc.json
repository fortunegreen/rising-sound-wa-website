        "selector": "JSXOpeningElement[name.name='VideoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|artist|duration|episode|image|tone|live|onPlay|className|key|ref|className|style|children)$/]",
        "message": "<VideoCard> doesn't accept that prop. Declared props: title, artist, duration, episode, image, tone, live, onPlay, className."
