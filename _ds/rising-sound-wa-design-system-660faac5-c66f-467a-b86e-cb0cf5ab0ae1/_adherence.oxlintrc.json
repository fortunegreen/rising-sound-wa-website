      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|bars|animate|color|className|key|ref|className|style|children)$/]",
        "message": "<Waveform> doesn't accept that prop. Declared props: height, bars, animate, color, className."
      }
